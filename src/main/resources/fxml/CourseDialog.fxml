<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      prefWidth="480.0" prefHeight="580.0" spacing="14.0" styleClass="card-panel">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <Label fx:id="headerLabel" text="✨ Create New Course" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <GridPane hgap="12.0" vgap="12.0">
        <Label text="Course Code:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="codeField" promptText="e.g. CS 101" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Course Title:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="titleField" promptText="e.g. Intro to Computer Science" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Credits:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <Spinner fx:id="creditsSpinner" editable="true" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Department:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="deptField" promptText="e.g. Computer Science" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Status:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <ComboBox fx:id="statusCombo" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Description:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <TextArea fx:id="descArea" promptText="Brief description of syllabus and outcomes..." prefRowCount="3" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
    </GridPane>

    <Label text="Select Prerequisites:" style="-fx-font-weight: 600;"/>
    <ListView fx:id="prereqListView" prefHeight="140.0"/>

    <Label fx:id="warningLabel" wrapText="true" style="-fx-text-fill: var(--danger); -fx-font-weight: bold; -fx-font-size: 12px;"/>

    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Button fx:id="saveBtn" text="Save Course" styleClass="btn-primary"/>
        <Button fx:id="cancelBtn" text="Cancel" styleClass="btn-secondary"/>
    </HBox>

</VBox>
